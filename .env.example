# Host port for the token server WebSocket.
TOKEN_SERVER_PORT=8080

# Host port for the cookie API (POST /v1/cookies).
COOKIE_SERVER_PORT=8081

# Virtual framebuffer size. Chrome runs headed against this display.
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# Start the OS-level checkbox clicker without pressing F8.
CLICKER_ENABLED=1

# Parallel Chrome processes for the cookie API. Each process is one
# concurrent /v1/get or /v1/cookies navigation, with its own profile and
# debugging port (9222, 9223, …). Default 1 so a small box does not OOM.
# Each extra Chrome needs about 1–2 GB of /dev/shm — raise shm_size in
# docker-compose.yml to match (BROWSER_COUNT=4 → shm_size: "8gb").
BROWSER_COUNT=1

# Seconds a /v1/get or /v1/cookies call will wait for a free Chrome slot
# before the server returns HTTP 503 + Retry-After. Page timeout starts
# only after a slot is acquired.
QUEUE_TIMEOUT=10

# Container port of the CDP proxy that publishes Chrome 0 to the host.
# Must be CDP_PORT + BROWSER_COUNT so it does not collide with per-Chrome
# debugging ports. BROWSER_COUNT=1 → 9223; BROWSER_COUNT=4 → 9226.
# CDP_PROXY_PORT=9223

# Set to 1 and connect a VNC client to localhost:5900 to see the display.
ENABLE_VNC=0
VNC_PORT=5900

# 1 = pass --no-sandbox (default; Chrome's sandbox usually cannot start in
# Docker). This weakens process isolation — see README "Chrome --no-sandbox".
# 0 = try the real sandbox (also set cap_add: SYS_ADMIN and
# security_opt: [seccomp=unconfined] in compose).
CHROME_NO_SANDBOX=1

# 0 = normal browsing (cookie API loads URLs on demand).
# 1 = replace navigations with the token harvester.
PAGE_OVERRIDE=0

TZ=UTC
