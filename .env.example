# Host port for the token server WebSocket.
TOKEN_SERVER_PORT=8080

# Host port for the cookie API (POST /v1/cookies).
COOKIE_SERVER_PORT=8081

# Virtual framebuffer size. Chrome runs headed against this display.
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# Start the OS-level checkbox clicker without pressing F8.
CLICKER_ENABLED=1

# How many Chrome windows to spawn (each gets its own profile).
BROWSER_COUNT=1

# Set to 1 and connect a VNC client to localhost:5900 to see the display.
ENABLE_VNC=0
VNC_PORT=5900

# 1 = pass --no-sandbox (default; Chrome's sandbox usually cannot start in
# Docker). This weakens process isolation — see README "Chrome --no-sandbox".
# 0 = try the real sandbox (also set cap_add: SYS_ADMIN and
# security_opt: [seccomp=unconfined] in compose).
CHROME_NO_SANDBOX=1

# 0 = normal browsing (cookie API loads URLs on demand).
# 1 = replace navigations with the token harvester.
PAGE_OVERRIDE=0

TZ=UTC
