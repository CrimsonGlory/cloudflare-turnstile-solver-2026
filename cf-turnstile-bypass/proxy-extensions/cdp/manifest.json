{
  "manifest_version": 3,
  "name": "CDP Proxy & Spoof Extension",
  "version": "1.0",
  "description": "CDP Implementation of this extension.",
  "permissions": [
    "debugger",
    "privacy",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}