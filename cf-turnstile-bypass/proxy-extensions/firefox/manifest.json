{
  "manifest_version": 3,
  "name": "Firefox Proxy Extension",
  "version": "1.0",
  "description": "Bridges webpage proxy requests, blocks WebRTC probing, and allows for JS API spoofs.",
  "permissions": [
    "proxy",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "privacy",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "proxy-bridge-extension@yourdomain.com",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_isolated.js"],
      "run_at": "document_start"
    }
  ]
}